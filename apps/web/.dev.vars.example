# Local secrets for `next dev` and `wrangler dev`. Copy to .dev.vars (never commit it).
# Production values are set with `wrangler secret put <NAME>`.
NEXTJS_ENV=development
# Any long random string, e.g. `openssl rand -base64 48`. Signs admin access tokens (ADR 0003).
JWT_ACCESS_SECRET=
# Leave empty to use Turnstile's public test secret (only while the site key is the test key).
TURNSTILE_SECRET_KEY=
