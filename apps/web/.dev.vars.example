# Local secrets for `next dev` and `wrangler dev`. Copy to .dev.vars (never commit it).
# Production values are set with `wrangler secret put <NAME>`.
NEXTJS_ENV=development
# Any long random string, e.g. `openssl rand -base64 48`. Signs admin access tokens (ADR 0003).
JWT_ACCESS_SECRET=
# Leave empty to use Turnstile's public test secret (only while the site key is the test key).
TURNSTILE_SECRET_KEY=

# Optional integrations (docs/runbooks/integrations.md). Leave empty and those jobs are skipped.
RESEND_API_KEY=
MAIL_FROM=
INTAKE_NOTIFY_EMAILS=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_INTAKE_TEMPLATE=
INTAKE_WHATSAPP_TO=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_QUALIFIED=
GOOGLE_ADS_CONVERSION_ACTION_RETAINED=

# "Publish changes" in /admin (docs/runbooks/deploy.md). Optional.
GITHUB_DEPLOY_TOKEN=
REVALIDATE_SECRET=
