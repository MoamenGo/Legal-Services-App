{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legal-services-app",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Every 10 minutes: retry pending notification and conversion jobs (ADR 0004).
  // Daily at 00:00 UTC (03:00 Riyadh): anonymize leads past LEAD_RETENTION_MONTHS (ADR 0006).
  "triggers": { "crons": ["*/10 * * * *", "0 0 * * *"] },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://legal-services-app.abdelmoamengomaa98.workers.dev",
    "NEXT_PUBLIC_DEFAULT_LOCALE": "ar",
    "INTAKE_LANGUAGE": "ar",
    "LEAD_RETENTION_MONTHS": "24",
    // Repository the admin "Publish changes" button rebuilds (needs the GITHUB_DEPLOY_TOKEN secret).
    "GITHUB_REPOSITORY": "MoamenGo/Legal-Services-App",
  },
  // POST /api/leads: 5 requests a minute per IP (AGENTS.md section 5).
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    // /api/auth/*: stricter than general traffic, on top of the 5-failure account lockout.
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "legal-services-db",
      "database_id": "881968c6-7c81-41ab-a95a-5f214b538012",
      "migrations_dir": "migrations",
    },
  ],
}
