{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:worker": "pnpm cf-typegen && opennextjs-cloudflare build",
    "preview": "pnpm cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "pnpm cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "lint": "eslint .",
    "typecheck": "pnpm cf-typegen && next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "admin:sql": "node --experimental-strip-types scripts/admin-sql.ts",
    "content:export": "node --experimental-strip-types scripts/export-content.ts",
    "e2e:prepare": "pnpm db:migrate:local && pnpm seed && pnpm content:export && pnpm build:worker",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@app/schemas": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@opennextjs/cloudflare": "^1.20.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "next": "~16.3.8",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
